{
  "name": "@cdx-extensions/cdx-apps",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "playground/mobile-sandbox",
      "samples/mobile/*",
      "samples/mobile/widgets/*",
      "samples/mobile/feature/*",
      "widgets/mobile/*",
      "features/mobile/*"
    ],
    "// nohoist": "Packages listed below are not hoisted to root. They stay in each workspace's node_modules so Metro (mobile) can resolve them from playground/mobile-sandbox. Web/Nx continue to use root node_modules.",
    "nohoist": [
      "**/axios",
      "**/axios/**",
      "**/axios-mock-adapter",
      "**/axios-mock-adapter/**",
      "**/react-native",
      "**/react-native/**",
      "**/expo",
      "**/expo/**",
      "**/@expo/**",
      "**/@react-native/**",
      "**/metro",
      "**/metro/**",
      "**/metro-*",
      "**/metro-*/**"
    ]
  },
  "scripts": {
    "postinstall": "node tools/scripts/patch-mui-esm.js",
    "build": "nx build",
    "build:sandbox": "nx build --configuration=sandbox",
    "build:stage": "nx build --configuration=stage",
    "build:production": "nx build --configuration=production",
    "submit-to-fi": "node tools/scripts/submit-to-fi-repo.js"
  },
  "dependencies": {
    "@cdx-extensions/di-sdk": "1.1.4",
    "@cdx-extensions/di-sdk-mobile": "2.1.6",
    "@cdx-extensions/di-sdk-types": "1.1.4",
    "@cdx-extensions/di-sdk-web": "2.1.4",
    "@cdx-extensions/extension-generator-mobile": "1.1.0",
    "@cdx-extensions/extension-generator-web": "1.1.0",
    "@cdx-extensions/widget-template-mobile": "1.1.8",
    "@cdx-extensions/widget-template-web": "1.1.5",
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "7.3.4",
    "@mui/material": "7.3.4",
    "@mui/system": "7.3.3",
    "axios": "1.16.0",
    "cache": "^3.0.0",
    "clear": "^0.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-react": "^7.14.5",
    "@emotion/babel-plugin": "11.11.0",
    "@eslint/js": "8.57.0",
    "@module-federation/enhanced": "~0.2.3",
    "@nx/eslint": "19.6.5",
    "@nx/eslint-plugin": "19.6.5",
    "@nx/jest": "19.6.5",
    "@nx/js": "19.6.5",
    "@nx/plugin": "19.6.5",
    "@nx/react": "19.6.5",
    "@nx/rollup": "19.6.5",
    "@nx/web": "19.6.5",
    "@nx/webpack": "19.6.5",
    "@nx/workspace": "19.6.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/rollup": "8.1.0",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "1.9.2",
    "@swc/cli": "0.3.14",
    "@swc/core": "1.5.7",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "15.0.6",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "29.5.12",
    "@types/node": "18.19.31",
    "@types/react": "18.2.33",
    "@types/react-dom": "18.2.14",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-jest": "29.7.0",
    "core-js": "3.36.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "glob": "^7.2.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-environment-node": "^29.4.1",
    "nx": "19.6.5",
    "nx-remotecache-gcs": "^2.1.0",
    "prettier": "^2.8.8",
    "react-refresh": "^0.14.0",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.3"
  },
  "overrides": {
    "node-forge": ">=1.4.0",
    "picomatch": ">=2.3.2 <3.0.0 || >=3.0.2 <4.0.0 || >=4.0.4",
    "brace-expansion": ">=1.1.13 <2.0.0 || >=2.0.3 <3.0.0",
    "shell-quote": ">=1.8.4",
    "tar": "7.5.21",
    "@expo/cli": {
      "tar": "7.5.21"
    },
    "cacache": {
      "tar": "7.5.21"
    },
    "follow-redirects": "1.15.6",
    "ejs": "3.1.10",
    "webpack": "5.88.0",
    "@xmldom/xmldom": "0.8.12",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch": "9.0.9",
    "test-exclude": "7.0.2",
    "koa": "3.1.2",
    "websocket-driver": "0.7.5"
  },
  "resolutions": {
    "shell-quote": ">=1.8.4",
    "tar": "7.5.21",
    "follow-redirects": "1.15.6",
    "ejs": "3.1.10",
    "webpack": "5.88.0",
    "@xmldom/xmldom": "0.8.12",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch": "9.0.9",
    "test-exclude": "7.0.2",
    "koa": "3.1.2",
    "websocket-driver": "0.7.5"
  },
  "nx": {
    "targets": {
      "generate-web-extensions": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx g @cdx-extensions/extension-generator-web:extensions-from-template",
          "forwardAllArgs": true
        }
      },
      "generate-web-widget": {
        "executor": "nx:run-commands",
        "options": {
          "command": "nx g @cdx-extensions/extension-generator-web:widget",
          "forwardAllArgs": true
        }
      },
      "list-web-widget-templates": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node node_modules/@cdx-extensions/extension-generator-web/dist/scripts/list-web-widget-templates.js"
        }
      }
    }
  }
}
